# Pabrika environment file for a VPS.
#
# Copy to /etc/pabrika.env (Docker and Podman --env-file format: KEY=value, one per line,
# no quotes, no "export"), then restrict it:
#   sudo install -m 640 -o root -g root deploy/pabrika.env.example /etc/pabrika.env
#
# For rootless Podman with the Quadlet unit use ~/.config/pabrika.env instead
# (chmod 600), because the unit reads it as your user.

# The exact public HTTPS URL: scheme and host (and port if not 443), no path, no trailing slash.
# A mismatch shows up as 403 origin_mismatch on every login.
BASE_URL=https://pabrika.example.com

# Allow anyone who can reach the site to create an account. Set to false after you have created
# your own users (see docs/deploy-vps.md, "Create the first user"). Users are then added
# with the CLI only.
ALLOW_SIGNUP=true

# The reverse proxy on the same host sits in front of the container, so trust its
# X-Forwarded-For header for rate limiting and logs. Keep this false if the container is ever
# reachable without the proxy.
TRUST_PROXY=true

# Do NOT set COOKIE_SECURE (the default true is right behind HTTPS).
# PORT and DB_PATH are set by the image (8080 and /data/pabrika.db); leave them alone.
