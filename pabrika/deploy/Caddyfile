# Caddy reverse proxy for Pabrika. Replace pabrika.example.com with your domain.
# Caddy gets and renews the Let's Encrypt certificate by itself (ports 80 and 443 must be open
# and the domain's A/AAAA record must already point at this server).
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Why each line matters is explained in docs/proxy.md.

pabrika.example.com {
	# Compress everything except the live-update stream (a buffering compressor stalls it).
	@compressible not path_regexp ^/api/v1/projects/[^/]+/events$
	encode @compressible gzip zstd

	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy 127.0.0.1:8080 {
		# Never buffer: live updates and /mcp stream.
		flush_interval -1
	}
}
