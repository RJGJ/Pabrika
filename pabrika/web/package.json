{
  "name": "pabrika-web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "mock": "bun scripts/mock-server.ts",
    "prebuild": "bun scripts/clean-dist.ts",
    "build": "vue-tsc --noEmit && vite build && bun scripts/clean-dist.ts --ensure && bun run check:dist",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check:dist": "bun scripts/check-dist.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.51.0",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.16",
    "markdown-it": "15.0.2",
    "pinia": "4.0.3",
    "reka-ui": "2.10.5",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.43",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "5.3.1",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
